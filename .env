# App
APP_ENV=development
APP_PORT=8080

# Existing Postgres from your Slardar app
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/slardar_db?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/slardar_db?sslmode=disable

# OpenSearch (from docker-compose service)
ELASTICSEARCH_URL=http://opensearch:9200
OPENSEARCH_URL=http://opensearch:9200
